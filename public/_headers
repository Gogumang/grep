# Netlify·Cloudflare Pages가 읽는 캐시 규칙.
# _astro 아래 파일은 이름에 콘텐츠 해시가 붙어 내용이 바뀌면 이름도 바뀐다.
# 그래서 영구 캐시를 걸어도 낡은 파일이 남지 않는다.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

# 폰트는 서브셋을 바꾸면 파일 이름도 함께 바꾼다 — 그래야 영구 캐시가 낡은 글자를 붙들지 않는다.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=86400

# HTML은 매번 확인한다 — 글이 추가되면 바로 보여야 한다.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
