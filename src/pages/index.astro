---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { loadManualPickUrls, loadPosts } from '@/service/content'
import { selectTodayPicks } from '@/service/picks'
import { PostExplorer } from '@/components/post/PostExplorer'
import { TodayPicks } from '@/components/post/TodayPicks'
import * as styles from '@/styles/home.css'

const [posts, manualPickUrls] = await Promise.all([loadPosts(), loadManualPickUrls()])
const picks = selectTodayPicks(posts, manualPickUrls)

/** 이 사이트가 무엇인지 알린다. 개별 글의 정본은 각 글 페이지에서 원문을 가리킨다. */
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'grep',
  description: '기업 기술블로그의 새 글을 한곳에 모았습니다.',
  url: Astro.site?.href,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.slice(0, 10).map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/posts/${post.id}`, Astro.site).href,
      name: post.title,
    })),
  },
}
---

<BaseLayout structuredData={structuredData}>
  <main class={styles.container}>
    {/* 캐러셀·필터·페이지 이동이 있어서 붙는다. 초기 HTML은 빌드 때 구워진다. */}
    <TodayPicks picks={picks} client:load />
    <PostExplorer posts={posts} client:load />
  </main>
</BaseLayout>
