---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { loadEvents } from '@/service/events'
import { formatEventPrice, formatEventSchedule } from '@/shared/utils/eventDates'
import * as layout from '@/styles/home.css'
import * as styles from '@/styles/events.css'

const events = await loadEvents()
---

<BaseLayout title="이벤트 — grep" description="개발자 컨퍼런스·밋업·해커톤 일정을 티켓타코·이벤터스에서 모았습니다.">
  <main class={layout.container}>
    <header class={styles.intro}>
      <h1 class={styles.heading}>
        개발자 이벤트 <span class={styles.count} data-events-count>{events.length}</span>
      </h1>
      <p class={styles.lead}>컨퍼런스·밋업·해커톤 일정입니다. 자세한 내용과 신청은 각 행사 페이지(티켓타코·이벤터스)에서 합니다.</p>
    </header>

    <p class={styles.empty} data-events-empty hidden={events.length > 0}>예정된 행사가 없습니다.</p>

    <ul class={styles.list}>
      {events.map((event) => (
        <li data-event-end={event.endDate}>
          <a class={styles.item} href={event.url} target="_blank" rel="noopener noreferrer">
            <div class={styles.body}>
              <h2 class={styles.title}>{event.title}</h2>
              <p class={styles.summary}>
                {[event.host, event.isOnline ? '온라인' : event.place].filter(Boolean).join(' · ')}
              </p>
              <p class={styles.schedule}>
                {/* 누르면 넘어갈 판매처를 미리 보여 준다 — 신청은 거기서 한다. */}
                {[formatEventSchedule(event), formatEventPrice(event), event.source].filter(Boolean).join(' · ')}
              </p>
            </div>
            <img class={styles.thumbnail} src={event.image} alt="" loading="lazy" width={456} height={256} />
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>

<script>
  import { toSeoulDate } from '@/shared/utils/eventDates'

  // 빌드 뒤에 끝난 행사를 숨긴다. 목록이 안 바뀌면 collector가 커밋하지 않아 다음 배포가 없고, 지난 행사가 남는다.
  const today = toSeoulDate(new Date())
  const items = [...document.querySelectorAll<HTMLElement>('[data-event-end]')]
  for (const item of items) {
    item.hidden = (item.dataset.eventEnd ?? '') < today
  }
  const visibleCount = items.filter((item) => !item.hidden).length
  const count = document.querySelector<HTMLElement>('[data-events-count]')
  if (count) count.textContent = String(visibleCount)
  const empty = document.querySelector<HTMLElement>('[data-events-empty]')
  if (empty) empty.hidden = visibleCount > 0
</script>
