---
import BaseLayout from '@/layouts/BaseLayout.astro'
import * as styles from '@/styles/notFound.css'
---

<BaseLayout title="페이지를 찾지 못했어요 — grep" description="요청한 주소에 해당하는 글이 없습니다.">
  <main class={styles.container}>
    <img
      class={styles.icon}
      src="/images/not-found.png"
      alt=""
      width={140}
      height={140}
    />
    <h1 class={styles.title}>앗, 페이지를 찾지 못했어요</h1>
    <p class={styles.description}>페이지 주소가 정확한지 확인해주세요</p>
    <a href="/" class={styles.homeButton}>홈으로 가기</a>
  </main>
</BaseLayout>
