---
import '@/shared/styles/reset.css'
import * as header from '@/components/header/SiteHeader.css'
import * as wordmark from '@/components/header/Wordmark.css'

interface Props {
  title?: string
  description?: string
  /** 원문이 정본임을 검색엔진에 알린다. 옮겨 실은 글이 원문을 밀어내지 않게 한다. */
  canonical?: string
  ogImage?: string
  /** schema.org 구조화 데이터. 검색·AI가 글의 출처·작성자·발행일을 읽는 경로다. */
  structuredData?: Record<string, unknown>
}

const {
  title = 'grep — 개발자 블로그 모아보기',
  description = '기업 기술블로그의 새 글을 한곳에 모았습니다.',
  canonical,
  ogImage,
  structuredData,
} = Astro.props

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined

/**
 * GA4 측정 ID. 브라우저에 그대로 실려 나가는 공개값이라 환경변수로 숨길 이유가 없다.
 * PROD에서만 싣는다 — 로컬 개발과 프리뷰 배포의 방문이 실제 통계에 섞이면
 * 방문자 수를 우리가 직접 부풀리게 된다.
 */
const GA_MEASUREMENT_ID = 'G-CWJ9Q7MFJN'
const isAnalyticsEnabled = import.meta.env.PROD
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    {/* 페인트 전에 테마를 정한다. 늦게 정하면 화면이 한 번 번쩍인다. */}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('grep-theme')
        const theme = stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        document.documentElement.dataset.theme = theme
      })()
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      아이콘을 네 벌 둔다. SVG만 두면 탭에는 뜨지만 즐겨찾기·홈 화면에서는 빈다 —
      그쪽은 대부분 래스터를 찾고, 없으면 글자 아이콘이나 화면 캡처로 대신한다.
      ico를 먼저 적어도 SVG를 아는 브라우저는 SVG를 고른다(더 구체적인 선언이 이긴다).
      전부 scripts/makeIcons.mjs가 favicon.svg 하나에서 만든다.
    */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* 모바일 브라우저가 주소창을 칠하는 색. 테마별로 따로 준다. */}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1319" media="(prefers-color-scheme: dark)" />

    {/*
      워드마크를 그리는 잘난체(7KB). CSS 안에서만 이름이 나오는 폰트는 브라우저가
      스타일시트를 다 읽고 나서야 발견한다 — 헤더 맨 왼쪽 글자가 늦게 바뀌어 한 번 튄다.
      같은 출처라도 crossorigin이 있어야 preload가 폰트의 실제 요청과 같은 것으로 취급된다.
    */}
    <link rel="preload" href="/fonts/jalnan2-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

    {/*
      본문 폰트. 폰트 스택 1순위인데 싣지 않으면 Pretendard가 깔린 기기에서만 적용된다
      — 방문자 대부분은 시스템 폰트로 떨어져서 토스와 자소 폭이 달라진다.
      dynamic-subset은 쓰인 글자의 조각만 받아 온다(한글 전체는 몇 MB다).
    */}
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />

    {/*
      토스가 공개한 이모지 폰트. 본문에 섞여 오는 1️⃣ 같은 글자를 원문과 같은 모양으로 그린다.
      시스템 이모지로 두면 OS마다 다르게 보이고, macOS에서는 입체 광택 모양이라 글과 겉돈다.
      스택 맨 뒤에 둔다 — tossface.css에는 unicode-range가 U+0-10FFFF인 face가 있어서
      앞에 두면 숫자까지 이 폰트가 가져간다(발행일이 "2 0 2 6년"처럼 벌어졌던 원인).
    */}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/toss/tossface@main/dist/tossface.css" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="grep" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    {/*
      트위터는 og:를 대부분 물려받지만 카드 종류만은 직접 읽는다. 제목·설명까지
      적어 두는 이유 — 슬랙·디스코드처럼 twitter: 를 먼저 보는 미리보기가 있다.
    */}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    {structuredData && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    {/*
      Google Analytics.
      is:inline이라야 Astro가 번들로 끌어가지 않고 gtag가 전역에 남는다.
      define:vars는 쓰지 않는다 — 스크립트를 IIFE로 감싸버려서 gtag가 그 안에 갇힌다
      (페이지뷰는 dataLayer로 잡히지만 나중에 gtag('event', ...)를 못 부른다).
      그래서 ID는 set:html 쪽에서 직접 넣는다.
    */}
    {isAnalyticsEnabled && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script
          is:inline
          set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${GA_MEASUREMENT_ID}');`}
        />
      </>
    )}
  </head>
  <body>
    {/* 테마 토글이 localStorage를 읽어야 해서 붙는다. */}
    <header class={header.header}>
      <div class={header.inner}>
        <a href="/" aria-label="grep 홈">
          <span class={wordmark.wordmark}>
            <span class={wordmark.text}><span class={wordmark.brand}>grep</span></span>
          </span>
        </a>
        <span class={header.spacer} />
        <button type="button" class={header.searchField} data-search-open aria-label="글 검색 열기">
          <span class={header.searchIcon} aria-hidden="true">🔍</span>
        </button>
        <button
          type="button"
          class={`${header.themeToggle} ${header.themeGlyph}`}
          data-theme-toggle
          aria-label="테마 바꾸기"
        ></button>
      </div>
    </header>
    <slot />

    <script>
      import { createSearchModal } from '@/components/search/searchModal'

      const root = document.documentElement

      // 버튼에 그려지는 달·해는 SiteHeader.css.ts가 data-theme을 보고 정한다.
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
        root.dataset.theme = next
        localStorage.setItem('grep-theme', next)
      })

      // 검색 모듈은 처음 열 때만 받는다 — 읽기만 하는 방문자는 내려받지 않는다.
      let modal: ReturnType<typeof createSearchModal> | null = null
      function openSearch() {
        modal ??= createSearchModal()
        modal.open()
      }

      document.querySelector('[data-search-open]')?.addEventListener('click', openSearch)

      /*
        '/'와 ⌘K 둘 다 받는다. 헤더에서 안내문을 걷어낸 뒤로는 어디에도 적혀 있지 않지만,
        쓰던 사람의 손이 기억하는 키를 없앨 이유는 없다.
        글자를 넣는 중이면 가로채지 않는다 — 검색창에 '/'를 못 치게 되면 안 된다.
      */
      const isTyping = (target: EventTarget | null) =>
        target instanceof HTMLElement &&
        (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName))

      addEventListener('keydown', (event) => {
        const isCommandK = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k'
        const isSlash = event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey
        if (!isCommandK && !(isSlash && !isTyping(event.target))) return
        event.preventDefault()
        openSearch()
      })
    </script>
  </body>
</html>
