---
import '@/shared/styles/reset.css'
import * as header from '@/components/header/SiteHeader.css'
import * as wordmark from '@/components/header/Wordmark.css'

interface Props {
  title?: string
  description?: string
  /** 원문이 정본임을 검색엔진에 알린다. 옮겨 실은 글이 원문을 밀어내지 않게 한다. */
  canonical?: string
  ogImage?: string
  /** schema.org 구조화 데이터. 검색·AI가 글의 출처·작성자·발행일을 읽는 경로다. */
  structuredData?: Record<string, unknown>
}

const {
  title = 'grep — 개발자 블로그 모아보기',
  description = '기업 기술블로그의 새 글을 한곳에 모았습니다.',
  canonical,
  ogImage,
  structuredData,
} = Astro.props

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    {/* 페인트 전에 테마를 정한다. 늦게 정하면 화면이 한 번 번쩍인다. */}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('grep-theme')
        const theme = stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        document.documentElement.dataset.theme = theme
      })()
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/*
      토스가 공개한 이모지 폰트. 본문에 섞여 오는 1️⃣ 같은 글자를 원문과 같은 모양으로 그린다.
      시스템 이모지로 두면 OS마다 다르게 보이고, macOS에서는 입체 광택 모양이라 글과 겉돈다.
    */}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/toss/tossface@main/dist/tossface.css" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    {structuredData && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    {/* 테마 토글이 localStorage를 읽어야 해서 붙는다. */}
    <header class={header.header}>
      <div class={header.inner}>
        <a href="/" aria-label="grep 홈">
          <span class={wordmark.wordmark}>
            <span class={wordmark.text}><span class={wordmark.brand}>grep</span></span>
          </span>
        </a>
        <span class={header.spacer} />
        <button type="button" class={header.themeToggle} data-search-open aria-label="글 검색 열기">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="8.6" cy="8.6" r="5.2" stroke="currentColor" stroke-width="2"></circle>
            <path d="M12.6 12.6L17 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </button>
        <button type="button" class={header.themeToggle} data-theme-toggle aria-label="테마 바꾸기">☾</button>
      </div>
    </header>
    <slot />

    <script>
      import { createSearchModal } from '@/components/search/searchModal'

      const root = document.documentElement
      const themeButton = document.querySelector('[data-theme-toggle]')

      function paintThemeButton() {
        if (themeButton) themeButton.textContent = root.dataset.theme === 'dark' ? '☀' : '☾'
      }
      paintThemeButton()

      themeButton?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
        root.dataset.theme = next
        localStorage.setItem('grep-theme', next)
        paintThemeButton()
      })

      // 검색 모듈은 처음 열 때만 받는다 — 읽기만 하는 방문자는 내려받지 않는다.
      let modal: ReturnType<typeof createSearchModal> | null = null
      function openSearch() {
        modal ??= createSearchModal()
        modal.open()
      }

      document.querySelector('[data-search-open]')?.addEventListener('click', openSearch)
      addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault()
          openSearch()
        }
      })
    </script>
  </body>
</html>
